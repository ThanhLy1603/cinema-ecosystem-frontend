{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 3,
  "printWidth": 120,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["src/types/*.ts", "src/main.tsx", "*.config.ts", "*.config.js"],
      "options": { "tabWidth": 2 }
    }
  ]
}
